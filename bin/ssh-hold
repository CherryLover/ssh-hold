#!/usr/bin/env bash
# ssh-hold — 把一条 SSH 连接撑住，后续命令复用它，不用再认证第二次。
# 密码或证书只在 start 时用一次，密码不落盘。通道断了不会自动重连。
set -euo pipefail

VERSION="1.3.0"

BASE="${SSH_HOLD_DIR:-$HOME/.ssh/hold}"
DEFAULT_NAME="default"

die() {
  echo "ssh-hold: $*" >&2
  exit 1
}

need_cmd() {
  command -v "$1" >/dev/null 2>&1 || die "找不到命令: $1"
}

# 解析自身真实路径（逐层跟随符号链接），用来定位同一份安装里的 lib/。
self_path() {
  local src dir
  src="${BASH_SOURCE[0]}"
  while [[ -L "$src" ]]; do
    dir="$(cd -P "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    [[ "$src" != /* ]] && src="$dir/$src"
  done
  dir="$(cd -P "$(dirname "$src")" && pwd)"
  printf '%s/%s' "$dir" "$(basename "$src")"
}

SELF="$(self_path)"
SELF_DIR="$(dirname "$SELF")"

# >>> EMBED_START  单文件构建时，scripts/build-standalone.py 会替换掉这一段。
# 源码树里没有内嵌副本，运行库从 lib/ 目录找。
HAS_EMBEDDED=0
embedded_lib() {
  return 1
}
# <<< EMBED_END

LIB_DIR=""
EMBED_DIR=""

# 单文件版把内嵌的运行时文件写进缓存目录再用；只在真正需要它们时才解包。
unpack_embedded() {
  local cache tmp
  [[ -n "$EMBED_DIR" ]] && return 0
  (( HAS_EMBEDDED )) || return 1
  cache="${XDG_CACHE_HOME:-$HOME/.cache}/ssh-hold/lib-${VERSION}"
  if [[ -f "$cache/paste.py" && -f "$cache/myshell.py" && -x "$cache/askpass" && -f "$cache/SKILL.md" ]]; then
    EMBED_DIR="$cache"
    return 0
  fi
  mkdir -p "$(dirname "$cache")" || return 1
  tmp="$(mktemp -d "${cache}.XXXXXX")" || return 1
  chmod 700 "$tmp"
  if ! embedded_lib "$tmp"; then
    rm -rf "$tmp"
    return 1
  fi
  # 并发解包时谁先落地算谁的，后到的丢掉自己那份。
  if [[ -f "$cache/paste.py" ]] || ! mv "$tmp" "$cache" 2>/dev/null; then
    rm -rf "$tmp"
  fi
  [[ -f "$cache/paste.py" ]] || return 1
  EMBED_DIR="$cache"
}

# lib/ 的查找顺序：环境变量 > 安装布局 > 源码树 > 旧版固定路径 > 单文件内嵌。
# 找不到时返回非 0，由调用方决定是报错还是接着往下走。
find_lib() {
  [[ -n "$LIB_DIR" ]] && return 0
  if [[ -n "${SSH_HOLD_LIB:-}" ]]; then
    [[ -f "$SSH_HOLD_LIB/paste.py" ]] || return 1
    LIB_DIR="$SSH_HOLD_LIB"
    return 0
  fi
  local cand
  for cand in "$SELF_DIR/../lib/ssh-hold" "$SELF_DIR/../lib" "$HOME/.local/lib/ssh-hold"; do
    if [[ -f "$cand/paste.py" && -f "$cand/askpass" ]]; then
      LIB_DIR="$(cd -P "$cand" && pwd)"
      return 0
    fi
  done
  unpack_embedded || return 1
  LIB_DIR="$EMBED_DIR"
}

resolve_lib() {
  find_lib && return 0
  if [[ -n "${SSH_HOLD_LIB:-}" ]]; then
    die "SSH_HOLD_LIB 里没有 paste.py: $SSH_HOLD_LIB"
  fi
  die "找不到运行库（askpass / paste.py）。请重新安装，或用 SSH_HOLD_LIB 指定 lib 目录。"
}

SKILL_FILE=""

# SKILL.md 的查找顺序：安装布局 > 源码树 > SSH_HOLD_LIB > 单文件内嵌解出来的缓存。
# 不复用 find_lib：本机若装过旧版，它会先命中那个没有 SKILL.md 的 lib 目录，
# 单文件版就再也走不到内嵌那一步了。
find_skill() {
  [[ -n "$SKILL_FILE" ]] && return 0
  local cand
  for cand in "$SELF_DIR/../share/ssh-hold/SKILL.md" "$SELF_DIR/../skill/SKILL.md"; do
    if [[ -f "$cand" ]]; then
      # 展开路径里的 bin/..，version 打出来才好看。
      SKILL_FILE="$(cd -P "$(dirname "$cand")" && pwd)/SKILL.md"
      return 0
    fi
  done
  if [[ -n "${SSH_HOLD_LIB:-}" && -f "$SSH_HOLD_LIB/SKILL.md" ]]; then
    SKILL_FILE="$SSH_HOLD_LIB/SKILL.md"
    return 0
  fi
  unpack_embedded || return 1
  [[ -f "$EMBED_DIR/SKILL.md" ]] || return 1
  SKILL_FILE="$EMBED_DIR/SKILL.md"
}

usage() {
  cat <<'EOF'
用法:
  ssh-hold start [选项] 用户@地址     用密码或证书把通道撑开
  ssh-hold paste [-n 名字] [--check]  读剪贴板里的 JumpServer 连接信息并撑开
  ssh-hold run  [名字] -- 命令...     走这条通道在远端执行命令
  ssh-hold shell [名字]               走进远端交互终端
  ssh-hold upload 名字 本地... 远端   把本机的文件或目录传到远端
  ssh-hold download 名字 远端... 本地 把远端的文件或目录取回本机
  ssh-hold status [名字]              看通道还在不在
  ssh-hold list                       列出所有通道
  ssh-hold stop [名字]                关掉通道
  ssh-hold link-myshell 用户@地址 [密码]  把那台机器上 MyShell 里存的服务器登记成通道
  ssh-hold skill install              把用法教给 Claude Code / Codex
  ssh-hold version                    显示版本和安装位置

start 选项:
  -n, --name 名字          通道名，默认 default。多台机器同时撑开时用来区分
  -p, --port 端口          默认 22
  --password-stdin         从标准输入读密码（给脚本 / Agent 用，密码不进命令行）
  --insecure               不校验主机指纹（地址常变的临时机器才用）
  --key                    改用密钥登录，而不是密码
  -i, --identity 文件      指定密钥
  -o 选项                  额外传给 ssh，可重复

paste 选项:
  -n, --name 名字          覆盖自动生成的通道名
  --check                  显示全部解析字段（包括明文密码），不连接；请勿外传
  --debug                  显示 SSH 连接过程，不显示密码，不自动重试
  --verify-password        本地核对剪贴板密码与手动输入是否一致，不联网、不显示密码
  --keep-password-spaces   密码本身包含首尾空白时保留；默认去除复制时带上的首尾空白
  --insecure               不校验主机指纹（默认仍校验）

link-myshell 选项（详见 ssh-hold link-myshell --help）:
  --group / --tag / --pick 只登记某个分组、某个标签、某个名字的服务器，可重复

skill 选项（详见 ssh-hold skill --help）:
  --claude / --codex       只装给其中一个，默认按本机装了哪个自动挑
  --dir 目录               装到指定的 skills 根目录

例子:
  ssh-hold start -n web -i ~/keys/vps.pem ubuntu@1.2.3.4
  ssh-hold run web -- uname -a
  ssh-hold run web -- 'ps aux | head'
  ssh-hold shell web
  ssh-hold upload web ./app.tar.gz /tmp/
  ssh-hold download web /var/log/nginx/error.log ./
  ssh-hold stop web
  ssh-hold skill install

环境变量:
  SSH_HOLD_DIR             通道记录目录，默认 ~/.ssh/hold
  SSH_HOLD_LIB             运行库目录，默认跟随可执行文件所在的安装

注意:
  - 名字写了就必须对得上，写错直接报错，不会退回去挑另一条通道执行
  - run 的远端命令前面一定要有 --，省略名字时也要写：ssh-hold run -- uname -a
  - 开着多条通道时，run / shell / stop 都必须写名字，不会替你猜
  - 经 MyShell 登记的通道只支持 run：凭据留在那台机器上，命令由它代为执行，最长 120 秒
  - upload / download 永远要写名字；最后一个参数是目的地，前面的都是源，目录会整个传
  - 凭据过期后，已经撑开的通道一般还能继续用；一旦断开就只能重新认证
  - 进来之后不要在远端敲 exit 关自己的登录；关通道用本机的 ssh-hold stop
  - 如果服务器或堡垒机设了「最长会话时间」，到点还是会被踢，这个挡不住
EOF
}

session_dir() { printf '%s/%s' "$BASE" "$1"; }
sock_path() { printf '%s/%s/sock' "$BASE" "$1"; }
meta_path() { printf '%s/%s/meta' "$BASE" "$1"; }
pid_path() { printf '%s/%s/keepalive.pid' "$BASE" "$1"; }
log_path() { printf '%s/%s/keepalive.log' "$BASE" "$1"; }

# 名字就是目录名。ASCII 部分只认字母、数字、点、下划线、短横线，其余文字（中文等）放行；
# 不能以短横线开头，也不能全是点——. 和 .. 会让通道目录落到 BASE 外面去。
valid_name() {
  local rest="${1//[A-Za-z0-9._-]/}"
  [[ "$1" == *[!.]* && "$1" != -* && "$rest" != *[[:ascii:]]* ]]
}

# paste 和 MyShell 转发都是 lib/ 里的 python 脚本；第一个参数是本程序的路径，供它们回调。
run_lib() {
  local script="$1"
  shift
  need_cmd python3
  resolve_lib
  python3 "$LIB_DIR/$script" "$SELF" "$@"
}
ensure_base() {
  mkdir -p "$BASE"
  chmod 700 "$BASE"
}

list_names() {
  ensure_base
  local d
  shopt -s nullglob
  for d in "$BASE"/*/meta; do
    basename "$(dirname "$d")"
  done
  shopt -u nullglob
}

# 只管读，不判好坏：读完 TARGET 还是空的就是坏记录，怎么处置由调用方定。
load_meta() {
  local name="$1" file
  file="$(meta_path "$name")"
  [[ -f "$file" ]] || die "没有名为 ${name} 的通道。先 ssh-hold start，或 ssh-hold list 看看。"
  # 先清空再读：这些是全局变量，不清的话上一条通道的值会冒充这一条。
  TARGET="" PORT="" STARTED="" AUTH="" INSECURE="" VIA="" REMOTE_ID=""
  # 语法都不对的文件直接 source 会让 bash 当场整个退出，所以先在子 shell 里试读一遍，
  # 不过关就当它是空的。不用 bash -n：3.2 上它碰到语法错误照样返回 0。
  # shellcheck disable=SC1090
  if (source "$file") >/dev/null 2>&1; then
    source "$file"
  fi
}

# 要拿记录去连远端的入口用这个：坏记录直接停下。
read_meta() {
  load_meta "$1"
  [[ -n "$TARGET" ]] || die "通道 ${1} 的记录坏了，建议 ssh-hold stop ${1} 后重开。"
}

write_meta() {
  local name="$1" dest
  dest="$(meta_path "$name")"
  umask 077
  cat >"$dest" <<EOF
TARGET=$(printf '%q' "$TARGET")
PORT=$(printf '%q' "$PORT")
NAME=$(printf '%q' "$name")
STARTED=$(printf '%q' "$STARTED")
AUTH=$(printf '%q' "$AUTH")
INSECURE=$(printf '%q' "$INSECURE")
EOF
}

master_check() {
  local name="$1"
  ssh -O check -o ControlPath="$(sock_path "$name")" dummy >/dev/null 2>&1
}

# 读出记录并确认通道还活着。run / shell / 传文件都从这里过，断线提示只有这一份。
require_alive() {
  read_meta "$1"
  [[ -z "$VIA" ]] || die "通道 ${1} 是经 ${VIA} 上的 MyShell 转发的，只支持 run。"
  master_check "$1" || die "通道 ${1} 已经断了，不会自动重连。证书通道用原来的 -i 再 start 一次；密码通道要重新拿到密码。"
}

ssh_through() {
  local name="$1"
  shift
  require_alive "$name"
  ssh \
    -o ControlPath="$(sock_path "$name")" \
    -o ControlMaster=no \
    -o BatchMode=yes \
    -o ConnectTimeout=8 \
    -p "$PORT" \
    "$TARGET" \
    "$@"
}

stop_keepalive() {
  local name="$1" pidfile pid
  pidfile="$(pid_path "$name")"
  if [[ -f "$pidfile" ]]; then
    pid="$(cat "$pidfile" 2>/dev/null || true)"
    if [[ -n "${pid:-}" ]] && kill -0 "$pid" 2>/dev/null; then
      kill "$pid" 2>/dev/null || true
    fi
    rm -f "$pidfile"
  fi
}

start_keepalive() {
  local name="$1" sock log pidfile
  sock="$(sock_path "$name")"
  log="$(log_path "$name")"
  pidfile="$(pid_path "$name")"
  stop_keepalive "$name"

  # 周期性在远端跑一个空命令，防止对端按「空闲」把连接掐掉。
  nohup bash -c '
    name="$1"
    sock="$2"
    log="$3"
    port="$4"
    target="$5"
    fail=0
    while [[ -S "$sock" ]]; do
      if ssh -O check -o ControlPath="$sock" dummy >/dev/null 2>&1 \
        && ssh -o ControlPath="$sock" -o ControlMaster=no -o BatchMode=yes \
             -o ConnectTimeout=8 -p "$port" "$target" true >/dev/null 2>&1; then
        fail=0
      else
        fail=$((fail + 1))
        printf "%s keepalive 失败 (%s)\n" "$(date "+%Y-%m-%d %H:%M:%S")" "$fail" >>"$log"
        if (( fail >= 3 )); then
          printf "%s 通道已断，停止保活\n" "$(date "+%Y-%m-%d %H:%M:%S")" >>"$log"
          exit 1
        fi
      fi
      sleep 20
    done
  ' ssh-hold-keepalive "$name" "$sock" "$log" "$PORT" "$TARGET" >>"$log" 2>&1 &
  echo $! >"$pidfile"
}

cmd_start() {
  need_cmd ssh
  ensure_base

  local name="$DEFAULT_NAME" port="22" password_stdin=0 insecure=0 use_key=0
  local identity="" extra_opts=()
  local target=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -n|--name) [[ $# -ge 2 ]] || die "--name 后面要跟名字"; name="$2"; shift 2 ;;
      -p|--port) [[ $# -ge 2 ]] || die "--port 后面要跟端口"; port="$2"; shift 2 ;;
      --password-stdin) password_stdin=1; shift ;;
      --insecure) insecure=1; shift ;;
      --key) use_key=1; shift ;;
      -i|--identity) [[ $# -ge 2 ]] || die "--identity 后面要跟密钥文件"; identity="$2"; use_key=1; shift 2 ;;
      -o) [[ $# -ge 2 ]] || die "-o 后面要跟 ssh 选项"; extra_opts+=(-o "$2"); shift 2 ;;
      -h|--help) usage; exit 0 ;;
      --) shift; break ;;
      -*) die "未知选项: $1" ;;
      *)
        if [[ -z "$target" ]]; then
          target="$1"
          shift
        else
          die "多余参数: $1"
        fi
        ;;
    esac
  done

  [[ -n "$target" ]] || die "请提供 用户@地址，例如 ubuntu@1.2.3.4"
  valid_name "$name" || die "通道名不能有空格、斜杠和标点（点、下划线、短横线除外），不能以短横线开头，也不能全是点"
  [[ "$port" =~ ^[0-9]+$ ]] && (( port >= 1 && port <= 65535 )) || die "端口不合法: $port"

  local dir sock
  dir="$(session_dir "$name")"
  sock="$(sock_path "$name")"
  mkdir -p "$dir"
  chmod 700 "$dir"

  if master_check "$name"; then
    die "通道 ${name} 已经在了。要重开先: ssh-hold stop ${name}"
  fi
  rm -f "$sock"

  TARGET="$target"
  PORT="$port"
  STARTED="$(date "+%Y-%m-%d %H:%M:%S")"
  AUTH="password"
  INSECURE="$insecure"
  if (( use_key )); then
    AUTH="key"
  fi

  local ssh_opts=(
    -fN
    -p "$port"
    -o ControlMaster=yes
    -o ControlPath="$sock"
    -o ControlPersist=yes
    -o ServerAliveInterval=15
    -o ServerAliveCountMax=4
    -o TCPKeepAlive=yes
    -o NumberOfPasswordPrompts=1
    -o ExitOnForwardFailure=yes
  )

  if (( insecure )); then
    ssh_opts+=(-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null)
  else
    ssh_opts+=(-o StrictHostKeyChecking=accept-new)
  fi

  if (( use_key )); then
    ssh_opts+=(-o PreferredAuthentications=publickey)
    if [[ -n "$identity" ]]; then
      [[ -f "$identity" ]] || die "密钥文件不存在: $identity"
      ssh_opts+=(-i "$identity" -o IdentitiesOnly=yes)
    fi
  else
    # 走密码时就别先试本机密钥：只认密码的服务器上容易把尝试次数用光。
    # 这里的逗号是 ssh 的选项值，加引号免得被当成数组分隔符。
    ssh_opts+=(
      -o "PreferredAuthentications=password,keyboard-interactive"
      -o PubkeyAuthentication=no
    )
  fi

  if (( ${#extra_opts[@]} )); then
    ssh_opts+=("${extra_opts[@]}")
  fi

  echo "正在撑开通道 ${name} -> ${target}:${port} ..."
  if (( use_key )); then
    ssh "${ssh_opts[@]}" "$target"
  elif (( password_stdin )); then
    local password=""
    IFS= read -r password || true
    [[ -n "$password" ]] || die "标准输入里没有密码"
    resolve_lib
    local askpass="$LIB_DIR/askpass"
    [[ -x "$askpass" ]] || die "找不到密码输入助手: $askpass"
    # Let SSH request the password directly, without matching terminal output.
    SSH_HOLD_PASSWORD="$password" SSH_ASKPASS="$askpass" \
      SSH_ASKPASS_REQUIRE=force DISPLAY="${DISPLAY:-ssh-hold}" \
      ssh "${ssh_opts[@]}" "$target"
  else
    echo "请输入密码（输入时不会显示）："
    ssh "${ssh_opts[@]}" "$target"
  fi

  if ! master_check "$name"; then
    rm -f "$sock"
    die "通道没撑起来。密码或密钥不对、凭据过期了，或者对方拒绝了连接。"
  fi

  write_meta "$name"
  start_keepalive "$name"

  echo
  echo "通道已撑开：$name"
  echo "  目标: $target:$port"
  echo "  时间: $STARTED"
  echo
  echo "之后可以这样用："
  echo "  ssh-hold run $name -- uname -a"
  echo "  ssh-hold run $name -- 'ps aux | head'"
  echo "  ssh-hold shell $name"
  echo "  ssh-hold status $name"
  echo "  ssh-hold stop $name"
}

existing_names() {
  local n
  NAMES=()
  while IFS= read -r n; do
    [[ -n "$n" ]] && NAMES+=("$n")
  done < <(list_names)
}

# 写了名字就必须命中，绝不退回去猜别的通道——猜错等于在别的机器上干活。
# 认不认得一个名字只看 list 里有没有它，不拿名字去拼路径探文件。
resolve_name() {
  local maybe="${1:-}" hint="${2:-}" n
  existing_names

  if [[ -z "$maybe" ]]; then
    (( ${#NAMES[@]} != 0 )) || die "现在没有撑开的通道。先 ssh-hold start 用户@地址"
    (( ${#NAMES[@]} == 1 )) || die "有多条通道，请写名字。现有: ${NAMES[*]}"
    printf '%s' "${NAMES[0]}"
    return 0
  fi

  (( ${#NAMES[@]} != 0 )) \
    || die "没有名为 ${maybe} 的通道，现在也没有任何通道，不执行。先 ssh-hold start 用户@地址"
  for n in "${NAMES[@]}"; do
    [[ "$n" != "$maybe" ]] || { printf '%s' "$n"; return 0; }
  done
  die "没有名为 ${maybe} 的通道，不执行。现有: ${NAMES[*]}${hint:+
$hint}"
}

cmd_run() {
  local name
  [[ $# -gt 0 ]] || die "用法: ssh-hold run [名字] -- 命令...  例如: ssh-hold run -- uname -a"

  if [[ "$1" == "--" ]]; then
    name="$(resolve_name)"
  else
    # 第一个参数一律当通道名。不存在就停下，不能顺手当成远端命令跑到别的通道上。
    name="$(resolve_name "$1" "如果 ${1} 是要在远端执行的命令，前面要加 --：ssh-hold run 名字 -- ${1} ...")"
    shift
    [[ $# -gt 0 ]] || die "请在 -- 后面写要执行的命令，例如: ssh-hold run ${name} -- uname -a"
    [[ "$1" == "--" ]] || die "通道名后面要加 --，例如: ssh-hold run ${name} -- $*"
  fi
  shift

  [[ $# -gt 0 ]] || die "请在 -- 后面写要执行的命令，例如: ssh-hold run ${name} -- uname -a"
  read_meta "$name"
  if [[ -n "$VIA" ]]; then
    # 和 ssh 一样把参数用空格拼成一条命令，交给远端的 shell 去解释。
    run_lib myshell.py exec "$VIA" "$REMOTE_ID" "$*"
    return
  fi
  ssh_through "$name" "$@"
}

# 本机路径补上 ./：带冒号的文件名不会被 scp 当成「主机:路径」，短横线开头的也不会被当成选项。
local_path() {
  case "$1" in
    /*) printf '%s' "$1" ;;
    *) printf './%s' "$1" ;;
  esac
}

remote_path() {
  printf '%s:%s' "$TARGET" "$1"
}

# 上传和下载是同一件事，只差哪一头在远端：前两个参数就是源和目的各自的写法。
# 底下是复用同一个套接字的 scp，一律带 -r，文件和目录不用分开处理。
cmd_transfer() {
  local src_side="$1" dst_side="$2" verb="$3" name p paths=()
  shift 3
  need_cmd scp
  (( $# >= 3 )) || die "用法: ssh-hold ${verb} 名字 源路径... 目的路径  例如: ssh-hold ${verb} web 源 目的"
  name="$(resolve_name "$1")"
  shift
  require_alive "$name"

  for p in "${@:1:$#-1}"; do
    paths+=("$("$src_side" "$p")")
  done
  paths+=("$("$dst_side" "${!#}")")

  scp -r \
    -o ControlPath="$(sock_path "$name")" \
    -o ControlMaster=no \
    -o BatchMode=yes \
    -o ConnectTimeout=8 \
    -P "$PORT" \
    "${paths[@]}"
}

cmd_shell() {
  local name
  (( $# <= 1 )) || die "shell 只收一个通道名，多余参数: ${*:2}"
  name="$(resolve_name "${1:-}")"
  require_alive "$name"
  echo "进入远端。出来时用 Ctrl+D 或 exit；通道本身不会因此关掉。"
  ssh \
    -t \
    -o ControlPath="$(sock_path "$name")" \
    -o ControlMaster=no \
    -o BatchMode=yes \
    -p "$PORT" \
    "$TARGET"
}

print_one_status() {
  local name="$1" alive="已断开" keep="无"
  load_meta "$name"
  # 坏记录只标出来，不能让它挡住排在后面的通道。
  if [[ -z "$TARGET" ]]; then
    printf '  %s\n    记录: 坏了，建议 ssh-hold stop %s 后重开\n' "$name" "$name"
    return 0
  fi
  if [[ -n "$VIA" ]]; then
    master_check "$VIA" && alive="畅通"
    printf '  %s\n    目标: %s:%s\n    经由: %s 上的 MyShell（%s），只支持 run\n' \
      "$name" "$TARGET" "$PORT" "$VIA" "$alive"
    return 0
  fi
  if master_check "$name"; then
    alive="畅通"
  fi
  local pidfile pid
  pidfile="$(pid_path "$name")"
  if [[ -f "$pidfile" ]]; then
    pid="$(cat "$pidfile" 2>/dev/null || true)"
    if [[ -n "${pid:-}" ]] && kill -0 "$pid" 2>/dev/null; then
      keep="在跑 (pid $pid)"
    else
      keep="停了"
    fi
  fi
  printf '  %s\n' "$name"
  printf '    目标: %s:%s\n' "$TARGET" "$PORT"
  printf '    开通: %s\n' "$STARTED"
  printf '    通道: %s\n' "$alive"
  printf '    保活: %s\n' "$keep"
  if [[ "$alive" == "畅通" ]]; then
    local who
    who="$(ssh_through "$name" 'printf "%s@%s" "$(id -un)" "$(hostname)"' 2>/dev/null || true)"
    if [[ -n "$who" ]]; then
      printf '    远端: %s\n' "$who"
    fi
  fi
}

cmd_status() {
  local names=()
  if [[ $# -gt 0 ]]; then
    names=("$@")
  else
    while IFS= read -r n; do
      [[ -n "$n" ]] && names+=("$n")
    done < <(list_names)
  fi
  if (( ${#names[@]} == 0 )); then
    echo "现在没有撑开的通道。"
    return 0
  fi
  echo "SSH 通道："
  local n
  for n in "${names[@]}"; do
    print_one_status "$n"
  done
}

cmd_stop() {
  local name
  (( $# <= 1 )) || die "stop 一次只关一条，请分开写。多余参数: ${*:2}"
  name="$(resolve_name "${1:-}")"
  # 这里故意不读 meta：记录坏了也得关得掉，否则「stop 后重开」这条建议就成了死路。
  # 登记来的通道：让 MyShell 把它那头的连接也关掉（有人开着终端就不动）。关不掉不碍事。
  load_meta "$name"
  [[ -z "$VIA" ]] || run_lib myshell.py close "$VIA" "$REMOTE_ID" 2>/dev/null || true
  # 经它转发的登记也一并清掉：没有它，那些记录哪儿也去不了。
  local n
  existing_names
  for n in "${NAMES[@]}"; do
    load_meta "$n"
    [[ "$VIA" != "$name" ]] || { rm -rf "$(session_dir "$n")"; echo "已清掉经它转发的登记：$n"; }
  done
  stop_keepalive "$name"
  if master_check "$name"; then
    ssh -O exit -o ControlPath="$(sock_path "$name")" dummy >/dev/null 2>&1 || true
  fi
  rm -rf "$(session_dir "$name")"
  echo "已关闭通道：$name"
}

skill_usage() {
  cat <<'EOF'
用法:
  ssh-hold skill install [选项]   把 SKILL.md 写进 AI 编程工具的 skills 目录
  ssh-hold skill path [选项]      只显示会写到哪些位置，不动文件
  ssh-hold skill show             把 SKILL.md 打到标准输出

选项:
  --claude        装给 Claude Code（~/.claude/skills/ssh-hold/）
  --codex         装给 Codex（~/.codex/skills/ssh-hold/）
  --dir 目录      装到指定的 skills 根目录，会在它下面建 ssh-hold/

不写 --claude / --codex / --dir 时，按本机装了哪个自动挑：~/.claude 和 ~/.codex
哪个存在就往哪个装，两个都在就都装。

已有的 SKILL.md 内容不一样时，会先备份成 SKILL.md.bak.<时间戳> 再覆盖；
内容一样则什么都不做。
EOF
}

write_skill_to() {
  local dest="$1" backup
  mkdir -p "$(dirname "$dest")"
  if [[ -f "$dest" ]]; then
    if cmp -s "$SKILL_FILE" "$dest"; then
      echo "已是最新：$dest"
      return 0
    fi
    backup="$dest.bak.$(date "+%Y%m%d%H%M%S")"
    cp "$dest" "$backup"
    echo "旧的已备份到 $backup"
  fi
  cp "$SKILL_FILE" "$dest"
  chmod 644 "$dest"
  echo "已写入 $dest"
}

# Claude Code 和 Codex 用的是同一种 SKILL.md 格式，一份文件两边都能用。
cmd_skill() {
  local sub="install"
  if [[ $# -gt 0 && "$1" != -* ]]; then
    sub="$1"
    shift
  fi

  local want_claude=0 want_codex=0 explicit=0
  local extra_dirs=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --claude) want_claude=1; explicit=1; shift ;;
      --codex) want_codex=1; explicit=1; shift ;;
      --dir)
        [[ $# -ge 2 ]] || die "--dir 后面要跟 skills 根目录"
        extra_dirs+=("$2"); explicit=1; shift 2 ;;
      -h|--help) skill_usage; return 0 ;;
      -*) die "未知选项: $1。看帮助: ssh-hold skill --help" ;;
      *) die "多余参数: $1" ;;
    esac
  done

  find_skill || die "找不到 SKILL.md。请重新安装 ssh-hold。"

  case "$sub" in
    show)
      cat "$SKILL_FILE"
      return 0
      ;;
    install|path) ;;
    *) die "未知的 skill 子命令: ${sub}。可用: install / path / show" ;;
  esac

  if (( ! explicit )); then
    [[ -d "$HOME/.claude" ]] && want_claude=1
    [[ -d "$HOME/.codex" ]] && want_codex=1
  fi

  local targets=()
  if (( want_claude )); then targets+=("$HOME/.claude/skills"); fi
  if (( want_codex )); then targets+=("$HOME/.codex/skills"); fi
  if (( ${#extra_dirs[@]} )); then targets+=("${extra_dirs[@]}"); fi

  if (( ${#targets[@]} == 0 )); then
    die "没找到 Claude Code（~/.claude）或 Codex（~/.codex）。
用 --dir 指定 skills 根目录，或先装上其中一个。"
  fi

  local root
  for root in "${targets[@]}"; do
    if [[ "$sub" == "path" ]]; then
      echo "$root/ssh-hold/SKILL.md"
    else
      write_skill_to "$root/ssh-hold/SKILL.md"
    fi
  done

  if [[ "$sub" == "install" ]]; then
    echo
    echo "新开一个会话才会加载到。"
  fi
}

cmd_version() {
  echo "ssh-hold $VERSION"
  echo "  程序: $SELF"
  if find_lib; then
    echo "  运行库: $LIB_DIR"
  else
    echo "  运行库: 找不到（paste 和 --password-stdin 用不了）"
  fi
  if find_skill; then
    echo "  技能文件: $SKILL_FILE"
  else
    echo "  技能文件: 找不到（ssh-hold skill install 用不了）"
  fi
  echo "  通道目录: $BASE"
}

main() {
  local cmd="${1:-}"
  if [[ -z "$cmd" || "$cmd" == "-h" || "$cmd" == "--help" ]]; then
    usage
    exit 0
  fi
  shift || true
  case "$cmd" in
    -V|--version|version) cmd_version ;;
    paste) run_lib paste.py "$@" ;;
    link-myshell) run_lib myshell.py link "$@" ;;
    skill) cmd_skill "$@" ;;
    start) cmd_start "$@" ;;
    run|exec) cmd_run "$@" ;;
    shell|sh) cmd_shell "$@" ;;
    upload|put) cmd_transfer local_path remote_path upload "$@" ;;
    download|get) cmd_transfer remote_path local_path download "$@" ;;
    status) cmd_status "$@" ;;
    list|ls) cmd_status ;;
    stop|close|exit) cmd_stop "$@" ;;
    *) die "未知命令: ${cmd}。看帮助: ssh-hold --help" ;;
  esac
}

main "$@"
